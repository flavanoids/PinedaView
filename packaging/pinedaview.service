# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=PinedaView dashboard server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pineda
Group=pineda
Environment=PINEDA_STATE_DIR=/var/lib/pinedaview
Environment=PINEDA_PHOTOS_DIR=/var/lib/pinedaview/photos
Environment=PINEDA_CARDS_DIR=/var/lib/pinedaview/cards
Environment=PINEDA_API__DB_PATH=/var/lib/pinedaview/pineda.db
Environment=PINEDA_CONFIG_FILE=/etc/pinedaview/config.toml
ExecStart=/usr/bin/pinedaview serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=pinedaview
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pinedaview

[Install]
WantedBy=multi-user.target
