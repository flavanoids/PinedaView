# SPDX-License-Identifier: Apache-2.0
# Kiosk-side primary/standby failover for pineda-web. Install on the kiosk
# device with nginx — see docs/OPERATIONS.md#standby-server:
#
#   sudo install -m 755 packaging/pineda-failover.sh /usr/local/bin/
#   sudo install -m 644 packaging/pineda-failover.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pineda-failover
#
# Set the two servers below (host:port, LAN IPs — not mDNS).
[Unit]
Description=PinedaDisplay kiosk failover (primary/standby pineda-web via nginx)
After=network-online.target nginx.service
Wants=network-online.target
Requires=nginx.service

[Service]
Environment=PINEDA_PRIMARY=192.0.2.171:8090
Environment=PINEDA_STANDBY=192.0.2.16:8090
ExecStart=/usr/local/bin/pineda-failover.sh
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
