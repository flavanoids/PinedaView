{
  "id": "news",
  "name": "News",
  "description": "Today's headlines from NPR, BBC, PBS, Al Jazeera, The Guardian and more, sorted into your beats (US, World, Good news, Houston), each over its own blurred photo with a QR code to the article.",
  "author": "pinedaview",
  "needs": [
    "network"
  ],
  "provides": [
    "news"
  ],
  "provider": "news",
  "refresh": {
    "interval": "30m"
  },
  "permissions": {
    "fetchHosts": [
      "feeds.bbci.co.uk",
      "feeds.npr.org",
      "houstonlanding.org",
      "news.mongabay.com",
      "reasonstobecheerful.world",
      "www.aljazeera.com",
      "www.houstonpublicmedia.org",
      "www.khou.com",
      "www.nasa.gov",
      "www.pbs.org",
      "www.positive.news",
      "www.sciencedaily.com",
      "www.theguardian.com"
    ]
  },
  "slots": {
    "min": "small",
    "ideal": "medium",
    "max": "hero"
  },
  "settings": {
    "beats": {
      "type": "beats",
      "title": "Beats",
      "description": "Groups of sources and keywords. Each beat gets its share of the headlines.",
      "default": [
        {
          "name": "US",
          "enabled": true,
          "weight": 1,
          "maxAgeHours": 24,
          "sources": [
            "npr-politics",
            "npr-news",
            "bbc-us",
            "pbs-politics",
            "pbs-nation",
            "guardian-us"
          ],
          "keywords": [
            "socialis*",
            "DSA",
            "Democratic Socialists",
            "Ocasio-Cortez",
            "AOC",
            "Sanders",
            "Mamdani",
            "progressive*",
