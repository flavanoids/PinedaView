        {
          "name": "Houston",
          "enabled": true,
          "weight": 1,
          "maxAgeHours": 24,
          "sources": [
            "houston-public-media",
            "houston-landing",
            "khou"
          ],
          "keywords": [],
          "exclude": []
        }
      ],
      "enum": [
        "npr-news",
        "npr-politics",
        "npr-world",
        "npr-science",
        "npr-health",
        "bbc-us",
        "bbc-world",
