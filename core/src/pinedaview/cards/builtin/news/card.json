            "AI",
            "artificial intelligence",
            "OpenAI",
            "Anthropic",
            "chatbot*",
            "data center*",
            "union*",
            "labor",
            "workers"
          ],
          "exclude": []
        },
        {
          "name": "World",
          "enabled": true,
          "weight": 1,
          "maxAgeHours": 24,
          "sources": [
            "bbc-world",
            "npr-world",
            "pbs-world",
            "aljazeera",
            "guardian-world"
