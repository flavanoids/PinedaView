            "storm*",
            "earthquake*",
            "flood*",
            "wildfire*",
            "tsunami",
            "volcan*",
            "drought",
            "famine",
            "heatwave*",
            "climate"
          ],
          "exclude": [
            "football",
            "cricket",
            "celebrity"
          ]
        },
        {
          "name": "Good news",
          "enabled": true,
          "weight": 1,
          "maxAgeHours": 72,
          "sources": [
            "npr-science",
            "npr-health",
            "bbc-science",
            "pbs-science",
            "guardian-science",
            "guardian-environment",
            "nasa",
            "sciencedaily",
            "mongabay",
            "reasons-to-be-cheerful",
            "positive-news"
          ],
          "keywords": [
            "breakthrough*",
