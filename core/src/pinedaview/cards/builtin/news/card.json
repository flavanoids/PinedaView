        "nasa",
        "sciencedaily",
        "mongabay",
        "reasons-to-be-cheerful",
        "positive-news",
        "houston-public-media",
        "houston-landing",
        "khou"
      ],
      "labels": {
        "npr-news": "NPR · Top stories",
        "npr-politics": "NPR · Politics",
        "npr-world": "NPR · World",
        "npr-science": "NPR · Science",
        "npr-health": "NPR · Health",
        "bbc-us": "BBC · US & Canada",
        "bbc-world": "BBC · World",
        "bbc-science": "BBC · Science & environment",
        "pbs-politics": "PBS · Politics",
        "pbs-nation": "PBS · Nation",
        "pbs-world": "PBS · World",
        "pbs-science": "PBS · Science",
        "aljazeera": "Al Jazeera · All news",
        "guardian-us": "The Guardian · US news",
        "guardian-world": "The Guardian · World",
        "guardian-environment": "The Guardian · Environment",
        "guardian-science": "The Guardian · Science",
        "nasa": "NASA · News releases",
        "sciencedaily": "ScienceDaily · Top science",
        "mongabay": "Mongabay · Conservation",
        "reasons-to-be-cheerful": "Reasons to be Cheerful · Solutions",
        "positive-news": "Positive News · Good news",
        "houston-public-media": "Houston Public Media · News",
        "houston-landing": "Houston Landing · News",
        "khou": "KHOU · Local news"
      }
    },
    "quietHours": {
      "type": "timerange",
      "title": "Quiet hours",
      "description": "No new headlines are fetched between these times.",
      "default": "22:00-05:00"
    },
    "softenMornings": {
      "type": "boolean",
      "title": "Gentler mornings",
      "description": "Leave out graphic headlines early in the morning.",
      "default": true
    },
    "softenWindow": {
      "type": "timerange",
      "title": "Early morning",
      "description": "When gentler mornings apply.",
      "default": "05:00-08:00"
    }
  },
  "entry": "news"
}
