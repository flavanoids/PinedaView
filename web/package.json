{
  "name": "@pinedaview/client",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build && size-limit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@size-limit/file": "^11.1.6",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.6",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.4.0",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "size-limit": "^11.1.6",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4",
    "@types/qrcode": "^1.5.5"
  },
  "size-limit": [
    {
      "name": "Start-up (what every screen parses)",
      "path": "dist/assets/index-*.js",
      "limit": "101 kB"
    },
    {
      "name": "Everything (Settings, builder and wizard included)",
      "path": "dist/assets/*.js",
      "limit": "153 kB"
    }
  ],
  "dependencies": {
    "@pinedaview/protocol": "workspace:*",
    "@pinedaview/tokens": "workspace:*",
    "qrcode": "^1.5.4"
  }
}
